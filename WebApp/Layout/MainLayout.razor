@using WebApp.Pages.Components
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="page">
    <main class="main">
        <div class="header">
            <div class="header-left">
                @if (!IsLoginPage)
                {
                    <a class="header-icon-link" href="/account">
                        <img class="header-icon" src="assets/house.svg" />
                    </a>
                }
            </div>
            <img class="logo" src="https://www.borncut.com/media/aigpqdfi/borncut_logo_white.svg">
            <div class="header-right">
                @if (!IsLoginPage)
                {
                    <button class="btn-logout" @onclick="Logout">Log out</button>
                }
            </div>
        </div>
        <div class="main-layout">
            <article class="main-content">
                @Body
            </article>
        </div>
    </main>
    <NotificationToast />
</div>

@code {
    private bool IsLoginPage => new Uri(Navigation.Uri).AbsolutePath == "/";

    private async Task Logout()
    {
        await localStorage.RemoveItemAsync("userId");
        Navigation.NavigateTo("/");
    }
}