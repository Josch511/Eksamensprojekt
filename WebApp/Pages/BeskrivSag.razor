@page "/beskriv-sag"
@using WebApp.Services
@inject FileService FileService

<PageTitle>Opret sag</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>Describe case</h2>
        <form class="form-default">
            <div class="input-container">
                <label for="caseTitle">Title</label>
                <input type="text" id="caseTitle" class="input-default">
            </div>
            <div class="input-container">
                <label for="caseDescription">Description</label>
                <textarea type="text" id="caseDescription" class="input-default" rows="4"></textarea>
            </div>
            
            <div class="image-upload-group">
                <label>Billede</label>
                <label class="image-upload-box" for="annonce-image-upload">
            @if (!string.IsNullOrWhiteSpace(FileService.PreviewUrl))
            {
                <img src="@FileService.PreviewUrl" alt="Forhåndsvisning af annoncebillede" />
            }
            else
            {
                <span class="upload-plus" aria-hidden="true">+</span>
            }

            <InputFile id="annonce-image-upload"
                       class="sr-only-file-input"
                       OnChange="FileService.HandleImageSelectedAsync"
                       accept="image/*" />
                </label>
            </div>
            
            <input type="submit" value="Submit" class="btn-primary"/>
        </form>
    
    </div>
</div>