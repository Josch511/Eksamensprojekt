@page "/caseconfirm"

<div class="case-parent">
    <div class="case-content">
        <h2>Review your case</h2>

        <h5 style="margin-top: -15px;">Product details</h5>
        <div class="order-item">
            <div class="input-container">
                <p class="secondary text-s">Product</p>
                <p>@order?.name</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Serial number</p>
                <p>@order?.serial</p>
            </div>
        </div>

        <h5 style="margin-top: 10px;">Case details</h5>
        <div class="order-item">
            <div class="input-container">
                <p class="secondary text-s">Case type</p>
                <p>@type</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Department</p>
                <p>@department</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Case title</p>
                <p>Fejl123</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Description</p>
                <p>blbalbalba</p>
            </div>
        </div>

        <h5 style="margin-top: 10px;">Contact details</h5>
        <div class="order-item">
            <div class="input-container">
                <p class="secondary text-s">Name</p>
                <p>Jonathan</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Telephone number</p>
                <p>12513136</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Email</p>
                <p>@user?.email</p>
            </div>
        </div>

        <button @onclick="Send" class="btn-primary" style="width:100%; margin-top: 15px;">Submit</button>
    </div>
</div>

@code {
    private int orderId;
    private int type;
    private int department;

    private OrderItems? order;
    private User? user;

    protected override async Task OnInitializedAsync()
    {
        orderId = await localStorage.GetItemAsync<int>("selectedOrderItemId");
        type = await localStorage.GetItemAsync<int>("type");
        department = await localStorage.GetItemAsync<int>("department");
    }
    private void Send()
    {
        Navigation.NavigateTo("/casedetail");
    }
}