@page "/case-confirm"
@using WebApp.Services
@inject CreateCaseService CaseService


<div class="case-parent">
    <div class="case-content">
        <h2>Review your case</h2>

        <h5 style="margin-top: -15px;">Product details</h5>
        <div class="order-item">
            <div class="input-container">
                <p class="secondary text-s">Product</p>
                <p>@CaseService.Data.Name</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Serial number</p>
                <p>@CaseService.Data.Serial</p>
            </div>
        </div>

        <h5 style="margin-top: 25px;">Case details</h5>
        <div class="order-item">
            <div class="input-container">
                <p class="secondary text-s">Case type</p>
                <p>@caseTypeLabel</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Department</p>
                <p>@departmentLabel</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Case title</p>
                <p>@CaseService.Data.CaseInfo.Title</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Description</p>
                <p>@CaseService.Data.CaseInfo.Description</p>
            </div>
        </div>

        <h5 style="margin-top: 25px;">Contact details</h5>
        <div class="order-item">
            <div class="input-container">
                <p class="secondary text-s">Name</p>
                <p>@CaseService.Data.CaseContact.Name</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Telephone number</p>
                <p>@CaseService.Data.CaseContact.Telephone</p>
            </div>
            <div class="input-container">
                <p class="secondary text-s">Email</p>
                <p>@CaseService.Data.CaseContact.Email</p>
            </div>
        </div>

        <button @onclick="Send" class="btn-primary" style="width:100%; margin-top: 25px;">Submit</button>
    </div>
</div>

@code {
    private string caseTypeLabel = string.Empty;
    private string departmentLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CaseService.Load();
        IdChange();
    }

    private async Task Send()
    {
        await CaseService.Submit();

        Navigation.NavigateTo("/casedetail");
    }

    private void IdChange()
    {
        var typeId = CaseService.Data.CaseTypeId;
        var deptId = CaseService.Data.CaseDepartmentId;

        caseTypeLabel = typeId switch
        {
            1 => "Problem / Error",
            2 => "Feature request",
            _ => "Other"
        };

        departmentLabel = deptId switch
        {
            1 => "Software",
            2 => "Mechanic",
            3 => "Electronic",
            4 => "Production",
            _ => "Other"
        };
    }
}
