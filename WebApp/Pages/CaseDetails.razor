@page "/case/{CaseId:int}"
@layout StaffLayout
@using Service
@inject ICaseService CaseService
@inject IOrderService OrderService 
@inject IUserService UserService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@using WebApp.Pages.Components
@using WebApp.Services

<div class="header">
    <h2>Sag #@CaseId</h2>
    <div class="action-items">
        <div class="action-item">
            <label for="caseStatus">Status</label>
            <select name="Status" id="caseStatus" class="input-select">
                <option value="open">Open</option>
                <option value="inProgress">In progress</option>
                <option value="closed">Closed</option>
            </select>
        </div>
        <div class="action-item">
            <label>Case owner</label>

            @if (currentCase.assignedEmployeeId == null || currentCase.assignedEmployeeId == 0)
            {
                <div>
                    <p>Case not assigned</p>
                    @if (loggedInUser.role == "employee")
                    {
                        <button class="btn-primary" @onclick="ClaimCase">
                            Claim case
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="case-owner">
                    <img src="favicon.png" />
                    <p>@assignedUser.name</p>
                    @if (loggedInUser.role == "employee")
                    {
                        <button class="btn-skeleton" @onclick="ReleaseCase">
                            Release
                        </button>
                    }
                </div>
            }
        </div>
        <div class="action-item">
            <label for="caseEta">Est. resolution</label>
            <input type="date" id="caseEta" class="input-default"/>
        </div>
    </div>
    <Stepper CurrentStep="@CurrentStep" />
</div>

<div class="row">
    <div class="column">
        <div class="updates-header">
            <h3>Updates</h3>
            <hr class="separator">
        </div>
        <div class="content-container">
            <div class="input-container input-comment">
                <textarea type="text" @bind="@commentInput" placeholder="Add a comment" class="input-default" rows="4"></textarea>
                <button class="btn-floating btn-primary" @onclick="SubmitComment">
                    <img src="assets/SubmitButtonIcon.svg"/>
                </button>
            </div>
            <div class="updates-container"></div>
            @foreach (var item in currentCase.caseUpdates)
            {
                <UpdateComponent Message="@item.message"
                                 Timestamp="@item.createdAt"
                                 IsComment="@item.isComment"
                                 CommentMessage = "@item.commentMessage"/>
                
            }
        </div>
    </div>
    <div class="column">
        <CaseSummary Case="@currentCase" />
    </div>
</div>

@code {
    [Parameter]
    public int CaseId { get; set; }

    private Cases currentCase = new();
    private string commentInput = "";
    private int CurrentStep = 1;
    
    private OrderItems? orderItem;
    
    private User assignedUser = new();
    private User loggedInUser = new();

    protected override async Task OnInitializedAsync()
    {
        currentCase = await CaseService.GetCaseByCaseId(CaseId);
        currentCase.caseUpdates = currentCase.caseUpdates
            .OrderByDescending(u => u.createdAt)
            .ToList();

        int loggedInId = await localStorage.GetItemAsync<int>("userId");
        loggedInUser = await UserService.GetUserById(loggedInId);

        if (currentCase.assignedEmployeeId.HasValue && currentCase.assignedEmployeeId.Value != 0)
        {
            assignedUser = await UserService.GetUserById(currentCase.assignedEmployeeId.Value);
        }

        CurrentStep = currentCase.status switch
        {
            "Case received"     => 1,
            "Assigned employee" => 2,
            "In progress"       => 3,
            "Testing"           => 4,
            "Finished"          => 5,
            _                   => 1
        };
    }

    private async Task SubmitComment()
    {
        if (string.IsNullOrWhiteSpace(commentInput))
        {
            return;
        }
        var update = new CaseUpdate()
        {
            message = "A staff member has added a comment",
            isComment = true,
            createdAt = DateTime.Now,
            commentMessage = commentInput

        };
        
        await CaseService.CreateCaseComment(CaseId, update.commentMessage);

        currentCase.caseUpdates.Insert(0, update);
        commentInput = string.Empty;
        orderItem = await OrderService.GetOrderById(currentCase.orderItemId);

        int loggedInId = await localStorage.GetItemAsync<int>("userId");
        loggedInUser = await UserService.GetUserById(loggedInId);

        if (currentCase.assignedEmployeeId.HasValue && currentCase.assignedEmployeeId.Value != 0)
        {
            assignedUser = await UserService.GetUserById(currentCase.assignedEmployeeId.Value);
        }
    }
    
    private async Task ClaimCase()
    {
        await CaseService.AssignCase(currentCase._id, loggedInUser._id.Value);
        currentCase.assignedEmployeeId = loggedInUser._id.Value;
        assignedUser = loggedInUser;
    }
    private async Task ReleaseCase()
    {
        await CaseService.ReleaseCase(currentCase._id);
        currentCase.assignedEmployeeId = null;
        assignedUser = new User();
    }
    public class CaseOwner
    {
        public int userId = 0;
        public static string name = "Søren Nielsen";
        public string? avatar;

    }
}
