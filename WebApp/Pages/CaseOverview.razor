@page "/case-overview"
@using Core
@using WebApp.Service
@inject ICaseService CaseService
@layout StaffLayout

    <div class="overview-content">
        <div class="Desc-Header">
            <h3>All Cases</h3>
        </div>

        <div class="status-frame">
            <div class="status-box">
                <h3 class="status-text">OPEN</h3>
                <p class="status-num">20</p>
            </div>

            <div class="status-box2">
                <h3 class="status-text">IN PROGRESS</h3>
                <p class="status-num">5</p>
            </div>

            <div class="status-box2">
                <h3 class="status-text">SOLVED</h3>
                <p class="status-num">10</p>
            </div>

            <div class="status-box2">
                <h3 class="status-text">TOTAL</h3>
                <p class="status-num">35</p>
            </div>
        </div>

        <table>
            <tr>
                <td>ID</td>
                <td>TITLE</td>
                <td>TYPE</td>
                <td>DEPARTMENT</td>
                <td>STATUS</td>
                <td>DATE</td>
            </tr>
            @foreach (var item in cases)
            {
                <tr>
                    <td>@item._id</td>
                    <td>@item.title</td>
                    <td>@item.status</td>
                    <td>@item.created_at.ToShortDateString()</td>
                </tr>
            }
        </table>
    </div>

@code {
    private List<Cases> cases = new();

    protected override async Task OnInitializedAsync()
    {
        cases = await CaseService.GetAllCases();
    }
}