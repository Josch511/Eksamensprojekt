@page "/case-overview"
@page "/case-overview/{DepartmentId:int}"
@page "/case-overview/my/{employeeId:int}"
@using Core
@using WebApp.Service
@inject ICaseService CaseService
@inject IUserService UserService
@inject NavigationManager Nav
@layout StaffLayout

    <div class="desc-header">
        <h3>@(EmployeeId.HasValue ? "My Cases" : "All Cases")</h3>
    </div>

    <div class="status-frame">
        <div class="status-box">
            <h3 class="status-text">OPEN</h3>
            <p class="status-num">@OpenCount</p>
        </div>

        <div class="status-box2">
            <h3 class="status-text">IN PROGRESS</h3>
            <p class="status-num">@InProgressCount</p>
        </div>

        <div class="status-box2">
            <h3 class="status-text">FINISHED</h3>
            <p class="status-num">@SolvedCount</p>
        </div>

        <div class="status-box2">
            <h3 class="status-text">TOTAL</h3>
            <p class="status-num">@TotalCount</p>
        </div>
    </div>

    <div class="table-box">
        <div class="table-filters">
            <div class="table-filters-left">
                <select class="table-select" name="Status" @bind="selectedStatus">
                    <option value="All">Status</option>
                    <option value="Open">OPEN</option>
                    <option value="Assigned">ASSIGNED</option>
                    <option value="InProgress">IN PROGRESS</option>
                    <option value="Solved">FINISHED</option>
                </select>
                <select class="table-select" name="Case Type" @bind="selectedType" @bind:after="ApplyFilters">
                    <option value="">Case Type</option>
                    <option value="1">Problem</option>
                    <option value="2">Feature</option>
                </select>
               
                
            </div>
            
        </div>

        <table class="cases-table">
            <thead>
                <tr class="table-header">
                    <th class="table-id">ID</th>
                    <th class="table-title">TITLE</th>
                    <th class="table-dep">CATEGORY</th>
                    <th class="table-dep">TYPE</th>
                    <th class="table-assign">ASSIGNED</th>
                    <th class="table-row-status">STATUS</th>
                    <th class="table-date">DATE</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredCases)
                {
                    <tr class="table-row" style="cursor:pointer" @onclick='() => Nav.NavigateTo($"/case/{item._id}")'>
                        <td>#@item._id</td>
                        <td>@item.title</td>
                        <td>@DepName(item.departmentId)</td>
                        <td>@TypeName(item.typeId)</td>
                        <td>@GetEmployeeName(item.assignedEmployeeId)</td>
                        <td>
                            <span class="table-status @GetStatusClass(item.status)">@item.status</span>
                        </td>
                        <td>@item.createdAt.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@code {
    private string selectedType = "";
    private List<Cases> cases = new();
    private List<User> employees = new();
    private string selectedStatus = "All";

    private IEnumerable<Cases> FilteredCases => cases.Where(c => MatchesStatus(c.status));

    private bool MatchesStatus(string status) => selectedStatus switch
    {
        "Open" => status == "Open" || status == "Case received",
        "Assigned" => status == "Assigned employee",
        "InProgress" => status == "In progress" || status == "Testing",
        "Solved" => status == "Finished",
        _ => true
    };

    protected override async Task OnParametersSetAsync()
    {
        selectedStatus = "All";

        cases = await CaseService.GetFilteredCases(DepartmentId, EmployeeId, null, null);

        foreach (var c in cases)
        {
            if (c.assignedEmployeeId.HasValue && c.assignedEmployeeId.Value != 0)
            {
                var user = await UserService.GetUserById(c.assignedEmployeeId.Value);
                if (user != null && !employees.Any(e => e._id == user._id))
                {
                    employees.Add(user);
                }
            }
        }
    }

    private async Task ApplyFilters()
    {
        int? typeId = string.IsNullOrEmpty(selectedType) ? null : int.Parse(selectedType);

        cases = await CaseService.GetFilteredCases(DepartmentId, EmployeeId, typeId, null);

        employees = new List<User>();
        foreach (var c in cases)
        {
            if (c.assignedEmployeeId.HasValue && c.assignedEmployeeId.Value != 0)
            {
                var user = await UserService.GetUserById(c.assignedEmployeeId.Value);
                if (user != null && !employees.Any(e => e._id == user._id))
                {
                    employees.Add(user);
                }
            }
        }
    }

    [Parameter]
    public int? DepartmentId { get; set; }

    [Parameter]
    public int? EmployeeId { get; set; }
    

    private string GetEmployeeName(int? employeeId)
    {
        if (employeeId == null || employeeId == 0) return "Unassigned";
        var user = employees.FirstOrDefault(e => e._id == employeeId);
        return user?.name ?? "Unassigned";
    }

    private string TypeName(int? id) => id switch
    {
        1 => "Problem",
        2 => "Feature",
        _ => "Unknown"
    };

    private string DepName(int? id) => id switch
    {
        1 => "Software",
        2 => "Electronic",
        3 => "Mechanic",
        4 => "Production",
        _ => "Unknown"
    };

    private string GetStatusClass(string status) => status switch
    {
        "Case received" => "status-open",
        "Assigned employee" => "status-assigned",
        "In progress" => "status-progress",
        "Testing" => "status-testing",
        "Finished" => "status-finished",
        _ => "status-default"
    };

    private int TotalCount => cases.Count;
    private int OpenCount => cases.Count(c => c.status == "Open" || c.status == "Case received");
    private int InProgressCount => cases.Count(c => c.status == "In progress" || c.status == "Testing");
    private int SolvedCount => cases.Count(c => c.status == "Finished");
}
