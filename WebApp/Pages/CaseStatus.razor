@page "/case-status/{id:int}"
@using Blazored.LocalStorage
@using WebApp.Pages.Components
@using WebApp.Service
@inject ILocalStorageService LocalStorage
@inject ICaseService CaseService
@inject IOrderService OrderService

@if (currentCase == null)
{
    <p>Ingen sag fundet</p>
}
else
{
    <Stepper CurrentStep="@CurrentStep" />
}

@code {
    [Parameter] public int id { get; set; }

    private Cases? currentCase;
    private int CurrentStep = 1;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        userId = await LocalStorage.GetItemAsync<int>("userId");

        currentCase = await CaseService.GetCaseByCaseId(id);

        if (currentCase != null)
        {
            CurrentStep = currentCase.status switch
            {
                "Case received"     => 1,
                "Assigned employee" => 2,
                "In progress"       => 3,
                "Testing"           => 4,
                "Finished"          => 5,
                _                   => 1
            };
        }
    }
}