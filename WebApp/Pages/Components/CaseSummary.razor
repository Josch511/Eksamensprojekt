@using Core
@using Service
@inject IFileService FileService

<div class="info-card">
    <h3>Case summary</h3>
    <div class="issue-summary">
        <h6>@Case.title</h6>
        <p class="secondary weight-r">@Case.description</p>
    </div>
    <div class="details-container">
        <div class="detail-item">
            <p class="secondary">Created at</p>
            <p>@Case.createdAt</p>
        </div>
        @if (Case.caseContact != null)
        {
            <div class="detail-item">
                <p class="secondary">Customer</p>
                <p>@Case.caseContact.Name</p>
            </div>
            <div class="detail-item">
                <p class="secondary">Contact email</p>
                <p>@Case.caseContact.Email</p>
            </div>
            <div class="detail-item">
                <p class="secondary">Contact tel</p>
                <p>@Case.caseContact.Telephone</p>
            </div>
        }
    </div>
    <div class="files-container">
        <h6>Attached files</h6>
        <div class="file-list">
            @if (Case.media != null && Case.media.Count > 0)
            {
                @foreach (string file in Case.media)
                {
                    <img src="@FileService.ConvertToUrl(file)" class="attached-image" />
                }
            }
            else
            {
                <p class="small secondary">No media attached.</p>
            }
        </div>
    </div>
</div>

    @if (Case.orderItem != null)
    {
        <div class="info-card">
            <h3>Product</h3>
            <div class="product-item">
                <img class="product-item_image" src="@Case.orderItem.image_url" alt="@Case.orderItem.name"/>
                <div class="product-item_info">
                    <p>@Case.orderItem.name</p>
                    <p class="secondary">Serial: @Case.orderItem.serial</p>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter, EditorRequired]
    public Cases Case { get; set; } = default!;

    [Parameter]
    public OrderItems? OrderItem { get; set; }
}
