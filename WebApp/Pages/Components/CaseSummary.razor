@using Core

<div class="info-card">
    <h3>Case summary</h3>
    <div class="issue-summary">
        <h6>Case title</h6>
        <p class="secondary">@Case.title</p>
        <h6>Case description</h6>
        <p class="secondary">@Case.description</p>
    </div>
    <hr class="separator" />
    <div class="details-container">
        <div class="detail-item">
            <p class="secondary">Created at</p>
            <p>@Case.createdAt</p>
        </div>
        @if (Case.caseContact != null)
        {
            <div class="detail-item">
                <p class="secondary">Customer</p>
                <p><strong>@Case.caseContact.Name</strong></p>
            </div>
            <div class="detail-item">
                <p class="secondary">Contact email</p>
                <p>@Case.caseContact.Email</p>
            </div>
            <div class="detail-item">
                <p class="secondary">Contact tel</p>
                <p>@Case.caseContact.Telephone</p>
            </div>
        }
    </div>
    @if (OrderItem != null)
    {
        <hr class="separator" />
        <h3>Product</h3>
        <div class="product-item">
            <img class="product-item_image" src="@OrderItem.image_url" alt="@OrderItem.name" />
            <div class="product-item_info">
                <p>@OrderItem.name</p>
                <p class="secondary">Serial: @OrderItem.serial</p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Cases Case { get; set; } = default!;

    [Parameter]
    public OrderItems? OrderItem { get; set; }
}
