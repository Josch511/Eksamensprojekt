@page "/contact-person"
@using WebApp.Service
@inject ICreateCaseService CreateCaseService
@inject NavigationManager Navigation
@inject NotificationService Notify

<PageTitle>Contact Person</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>Contact Person</h2>
        <form class="form-default" @onsubmit="Next" @onsubmit:preventDefault>
            <div class="input-container">
                <label for="contactName">Name</label>
                <input type="text" @bind="CreateCaseService.Data.CaseContact.Name" id="contactName" class="input-default" required>
            </div>
            <div class="input-container">
                <label for="contactPhone">Telephone</label>
                <input type="tel" @bind="CreateCaseService.Data.CaseContact.Telephone" id="casePhone" class="input-default" required>
            </div>
            <div class="input-container">
                <label for="contactEmail">Email</label>
                <input type="email" @bind="CreateCaseService.Data.CaseContact.Email" id="caseEmail" class="input-default">
            </div>
            
            <input type="submit" value="Submit" class="btn-primary" />
        </form>
    </div>
</div>

@code
{
    protected override async Task OnInitializedAsync()
    {
        await CreateCaseService.Load();
    }

    private async Task Next()
    {
        await CreateCaseService.Save();

        if (CreateCaseService.CaseContactIsValid())
        {
            Navigation.NavigateTo("/case-confirm");
        }
        else
        {
            Notify.Error("Fill in all required fields to continue");
        }
    }
}

