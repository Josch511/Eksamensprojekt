@page "/contact-person"
@using WebApp.Services
@inject CreateCaseService CaseService
@inject NavigationManager Navigation

<PageTitle>Contact Person</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>Contact Person</h2>
        <form class="form-default" @onsubmit="Next" @onsubmit:preventDefault>
            <div class="input-container">
                <label for="contactName">Name</label>
                <input type="text" @bind="CaseService.CurrentCase.CaseContact.Name" id="contactName" class="input-default" required>
            </div>
            <div class="input-container">
                <label for="contactPhone">Telephone</label>
                <input type="tel" @bind="CaseService.CurrentCase.CaseContact.Telephone" id="casePhone" class="input-default" required>
            </div>
            <div class="input-container">
                <label for="contactEmail">Email</label>
                <input type="email" @bind="CaseService.CurrentCase.CaseContact.Email" id="caseEmail" class="input-default">
            </div>
            
            <input type="submit" value="Submit" class="btn-primary"/>
        </form>
    </div>
</div>

@code
{
    protected override async Task OnInitializedAsync()
    {
        await CaseService.Load();
    }

    private async Task Next()
    {
        await CaseService.Save();

        if (CaseService.CaseContactIsValid())
        {
            Navigation.NavigateTo("/case-confirm");
        }
    }
}
