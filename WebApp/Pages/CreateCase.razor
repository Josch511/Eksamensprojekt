@page "/create-case"
@using WebApp.Service
@inject CreateCaseService CaseService
@inject NavigationManager Navigation

<PageTitle>Create a case</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>What is the case about?</h2>

        <div class="case-type">
            <h4>Case type</h4>
            <div class="case-type_select">
                <button class="case-type_select-item @(CaseService.Data.CaseTypeId == 1 ? "active" : "")"
                        @onclick="@(() => SelectCaseType(1))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/bug.svg" />
                    </div>
                    <p class="case-type_select-item-text">Problem/Error</p>
                </button>
                <button class="case-type_select-item @(CaseService.Data.CaseTypeId == 2 ? "active" : "")"
                        @onclick="@(() => SelectCaseType(2))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/settings-2.svg" />
                    </div>
                    <p class="case-type_select-item-text">Feature request</p>
                </button>
            </div>
        </div>

        <div class="case-departments">
            <h4>Department</h4>
            <div class="department-list">
                <button class="department-item @(CaseService.Data.CaseDepartmentId == 1 ? "active" : "")"
                        @onclick="@(() => SelectDepartment(1))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/code-xml.svg" />
                    </div>
                    <p class="department-item-title">Software</p>
                </button>
                <button class="department-item @(CaseService.Data.CaseDepartmentId == 2 ? "active" : "")"
                        @onclick="@(() => SelectDepartment(2))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/plug.svg" />
                    </div>
                    <p class="department-item-title">Electronic</p>
                </button>
                <button class="department-item @(CaseService.Data.CaseDepartmentId == 3 ? "active" : "")"
                        @onclick="@(() => SelectDepartment(3))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/wrench.svg" />
                    </div>
                    <p class="department-item-title">Mechanic</p>
                </button>
                <button class="department-item @(CaseService.Data.CaseDepartmentId == 4 ? "active" : "")"
                        @onclick="@(() => SelectDepartment(4))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/factory.svg" />
                    </div>
                    <p class="department-item-title">Production</p>
                </button>
            </div>
        </div>

        <div class="content-footer">
            <button class="btn-primary" @onclick="Next">Continue</button>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await CaseService.Load();
    }

    private void SelectCaseType(int value) => CaseService.Data.CaseTypeId = value;
    private void SelectDepartment(int value) => CaseService.Data.CaseDepartmentId = value;

    private async Task Next()
    {
        await CaseService.Save();
        if (CaseService.CaseTypeIsValid())
        {
            Navigation.NavigateTo("/describe-case");
        }
    }
}



