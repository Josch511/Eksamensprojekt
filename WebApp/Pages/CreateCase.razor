@page "/create-case"
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Create a case</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>What is the case about?</h2>

        <div class="case-type">
            <h4>Case type</h4>
            <div class="case-type_select">
                <div class="case-type_select-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/bug.svg"/>
                    </div>
                    <button class="case-type_select-item-text">Problem/Error</button>
                </div>
                <div class="case-type_select-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/settings-2.svg"/>
                    </div>
                    <button class="case-type_select-item-text">Feature request</button>
                </div>
            </div>
        </div>
        <div class="case-departments">
            <h4>Department</h4>
            <div class="department-list">
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/code-xml.svg"/>
                    </div>
                    <button class="department-item-title">Software</button>
                </div>
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/plug.svg"/>
                    </div>
                    <button class="department-item-title">Electronic</button>
                </div>
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/wrench.svg"/>
                    </div>
                    <button class="department-item-title">Mechanic</button>
                </div>
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/factory.svg"/>
                    </div>
                    <button class="department-item-title">Production</button>
                </div>
            </div>
        </div>
    </div>
</div>




