@page "/create-case"
@using WebApp.Service
@inject ICreateCaseService CreateCaseService
@inject NavigationManager Navigation
@inject NotificationService Notify
@inject WebApp.Service.IDepartmentService DepartmentService

<PageTitle>Create a case</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>What is the case about?</h2>

        <div class="case-type">
            <h4>Case type</h4>
            <div class="case-type_select">
                <button class="case-type_select-item @(CreateCaseService.Data.CaseTypeId == 1 ? "active" : "")"
                        @onclick="@(() => SelectCaseType(1))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/bug.svg" />
                    </div>
                    <p class="case-type_select-item-text">Problem/Error</p>
                </button>
                <button class="case-type_select-item @(CreateCaseService.Data.CaseTypeId == 2 ? "active" : "")"
                        @onclick="@(() => SelectCaseType(2))">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/settings-2.svg" />
                    </div>
                    <p class="case-type_select-item-text">Feature request</p>
                </button>
            </div>
        </div>

        <div class="case-departments">
            <h4>Department</h4>
            <div class="department-list">
                @foreach (var dept in departments)
                {
                    var icon = dept._id switch
                    {
                        1 => "assets/code-xml.svg",
                        2 => "assets/plug.svg",
                        3 => "assets/wrench.svg",
                        4 => "assets/factory.svg",
                        _ => "assets/department.svg"
                    };
                    var isActive = CreateCaseService.Data.CaseDepartmentId == dept._id ? "active" : "";
                    <button class="department-item @isActive"
                            @onclick="@(() => SelectDepartment(dept._id))">
                        <div class="case_icon-wrapper">
                            <img class="case_icon" src="@icon" />
                        </div>
                        <p class="department-item-title">@dept.name</p>
                    </button>
                }
            </div>
        </div>
        <div class="content-footer">
            <button class="btn-primary" @onclick="Next">Continue</button>
        </div>
    </div>
</div>

@code {
    private List<Departments> departments = new();

    protected override async Task OnInitializedAsync()
    {
        await CreateCaseService.Load();

        try
        {
            departments = await DepartmentService.GetAllDepartments();
        }
        catch (HttpRequestException)
        {
            
        }
    }

    private void SelectCaseType(int value) => CreateCaseService.Data.CaseTypeId = value;
    private void SelectDepartment(int value) => CreateCaseService.Data.CaseDepartmentId = value;

    private async Task Next()
    {
        await CreateCaseService.Save();
        if (CreateCaseService.CaseTypeIsValid())
        {
            Navigation.NavigateTo("/describe-case");
        }
        else
        {
            Notify.Error("Fill in all required fields to continue");
        }
    }
}



