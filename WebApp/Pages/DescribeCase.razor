@page "/describe-case"
@using WebApp.Service
@inject IFileService FileService
@inject CreateCaseService CaseService
@inject NavigationManager Navigation
@inject NotificationService Notify

<PageTitle>Opret sag</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>Describe case</h2>
        <form class="form-default" @onsubmit="Next" @onsubmit:preventDefault>
            <div class="input-container">
                <label for="caseTitle">Title</label>
                <input type="text" @bind="CaseService.Data.CaseInfo.Title" id="caseTitle" class="input-default">
            </div>
            <div class="input-container">
                <label for="caseDescription">Description</label>
                <textarea type="text" @bind="CaseService.Data.CaseInfo.Description" id="caseDescription" class="input-default" rows="4"></textarea>
            </div>
            
            <div class="image-upload-group">
                <div class="label-group">
                    <div>
                        <label>Upload et billede eller en fil</label>
                        <label class="text-s secondary">Valgfrit</label>
                    </div>
                    <p class="weight-r secondary">Filer hjælper os finde frem til problemet hurtigere</p>
                </div>
                
                <label class="image-upload-box" for="annonce-image-upload">
                    @if (keys.Any())
                    {
                        @foreach (string key in keys)
                        {
                            <img src="@FileService.ConvertToUrl(key)" alt="Forhåndsvisning af annoncebillede"/>
                        }
                    }
                    else
                    {
                        <span class="upload-plus" aria-hidden="true">+</span>
                    }

                    <InputFile id="annonce-image-upload"
                               class="sr-only-file-input"
                               OnChange="@UploadFile"
                               accept="image/*"/>
                </label>
            </div>
            
            <input type="submit" value="Submit" class="btn-primary"/>
        </form>
    </div>
</div>

@code
{
    protected override async Task OnInitializedAsync()
    {
        await CaseService.Load();
    }
    
    private async Task Next()
    {
        await CaseService.Save();

        if (CaseService.CaseInfoIsValid())
        {
            Navigation.NavigateTo("/contact-person");
        }
        else
        {
            Notify.Error("Fill in all required fields to continue");
        }
    }
    
    private string statusMessage = "";
    private List<string> keys = new();
    
    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        // compute a stream to the file chosen by the user
        var file = e.File;
        var stream = file.OpenReadStream(maxAllowedSize: 10_000_000); // fx 10 MB
        
        var res = await FileService.SendFile(file.Name, stream);
        
        statusMessage = res.success ? 
            $"Success! Info fra server: <{res.info}>" : 
            $"Fejl: {res.info}";
        
        keys.Add(res.info);
        CaseService.Data.CaseInfo.AttachmentUrl = keys;
    }
}
