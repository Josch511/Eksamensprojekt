@page "/"
@using Core
@using Service
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NotificationService Notify

<div class="login-container">
<div class="login-form">
<h3>Login</h3>
<div class="login-fields">
<input class="input-default" placeholder="Email" @bind="email" required/>
<input class="input-default" placeholder="Password" type="password" @bind="password" required/>
</div>

<button class="btn-primary"@onclick="LoginUser">Login</button>
</div>
</div>

@code {
    string email, password, message;
    
    async Task LoginUser()
    {
        var user = new { email, password };
        var response = await Http.PostAsJsonAsync("/user/login", user);

        if (response.IsSuccessStatusCode)
        {
            var loggedInUser = await response.Content.ReadFromJsonAsync<User>();
            await localStorage.SetItemAsync("userId", loggedInUser._id);
            

            if (loggedInUser.role == "employee")
            {
                Navigation.NavigateTo("/case-overview");
            }
            else
            {
                Navigation.NavigateTo("/account");
            }
        }
        else
        {
            Notify.Error("Email or password is incorrect");
        }
    }
}