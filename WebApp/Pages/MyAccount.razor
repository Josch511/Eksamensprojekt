@page "/account"
@inject IOrderService OrderService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager Navigation
@using Core

<PageTitle>My account</PageTitle>

<h2>My products</h2>

@if (orders == null)
{
    <p>Loader...</p>
}
else if (!orders.Any())
{
    <p>No products found.</p>
}
else
{
    <div class="order-list">

        @foreach (var order in orders)
        {
            <div class="order-item">

                <img class="order-item_image" src="@order.image_url">

                <div class="order-item_info">

                    <h3>@order.name</h3>

                    <div class="order-item_info_details">
                        <p>Serial: @order.serial</p>
                        <p>Purchased: @order.purchased_at.ToShortDateString()</p>
                    </div>

                    <button @onclick="() => CreateCase(order._id)">
                        Create case
                    </button>

                </div>
            </div>
        }

    </div>
}

@code {

    private List<OrderItems> orders = new();

    protected override async Task OnInitializedAsync()
    {
        var userId = await localStorage.GetItemAsync<int>("userId");

        orders = await OrderService.GetCustomerOrders(userId);
    }


    private async Task CreateCase(int orderItemId)
    {
        await localStorage.SetItemAsync("selectedOrderItemId", orderItemId);

        Navigation.NavigateTo("/create-case");
    }
}