@page "/account"
@inject IOrderService OrderService
@inject ICaseService CaseService
@inject CreateCaseService CreateCaseService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject NavigationManager Navigation
@using WebApp.Service
@using WebApp.Services

<PageTitle>My account</PageTitle>
<div class="account-layout">
    <div class="left-container">
        <h2>My products</h2>

        @if (orders == null)
        {
            <p>Loader...</p>
        }
        else if (!orders.Any())
        {
            <p>No products found.</p>
        }
        else
        {
            <div class="order-list">

                @foreach (var order in orders)
                {
                    <div class="order-item">

                        <img class="order-item_image" src="@order.image_url">

                        <div class="order-item_info">

                            <h3>@order.name</h3>

                            <div class="order-item_info_details">
                                <p>Serial: @order.serial</p>
                                <p>Purchased: @order.purchased_at.ToShortDateString()</p>
                            </div>

                            <button @onclick="() => CreateCase(order)">
                                Create case
                            </button>

                        </div>
                    </div>
                }
            </div>
        }</div>
    
<div class="right-container">
    <div class="header-container">
        <h2>My current cases</h2>
        <button class="btn-closed-cases">Previous cases</button>
    </div>

    @if (!currentCases.Any())
    {
        <p>No current cases.</p>
    }
    else
    {
        <div class="current-cases">
            @foreach (var currentCase in currentCases)
            {
                <div class="case-card">
                    <img class="case-image" src="@(currentCase.media?.FirstOrDefault() ?? "https://www.borncut.com/media/zbuk1uvo/img_1315.png?rmode=max&width=0&height=700&v=1db89da02bedbe0&quality=80")" />
                    <div class="case-details">
                        <span class="case-status">@currentCase.status</span>
                        <h4 class="case-title">Case #@currentCase._id</h4>
                        <h4 class="case-title">Title:@currentCase.title</h4>
                        <p class="case-meta">Product serial: @currentCase.orderItemId</p>
                        <p class="case-meta">Case type: @TypeName(currentCase.typeId) &nbsp; Department: @DepName(currentCase.departmentId)</p>
                    </div>
                    <a class="case-view" href="/case-status/@currentCase._id">View <img class="sidebar-icon" src="assets/arrow-right.svg" /></a>
                </div>
                <hr class="case-divider" />
            }
        </div>
    }
</div>
</div>

@code {
    private List<OrderItems> orders = new();
    private List<Cases> currentCases = new();

    protected override async Task OnInitializedAsync()
    {
        var userId = await localStorage.GetItemAsync<int>("userId");

        orders = await OrderService.GetCustomerOrders(userId);
        currentCases = await CaseService.GetCasesById(userId);
    }

    private async Task CreateCase(OrderItems order)
    {
        await CreateCaseService.Load();

        CreateCaseService.Data.OrderId = order._id;
        CreateCaseService.Data.Name = order.name;
        CreateCaseService.Data.Serial = order.serial;

        await CreateCaseService.Save();

        if (CreateCaseService.CaseOrderIdIsValid())
        {
            Navigation.NavigateTo("/create-case");
        }
    }

    private string TypeName(int? id) => id switch
    {
        1 => "Problem",
        2 => "Feature",
        _ => "Unknown"
    };

    private string DepName(int? id) => id switch
    {
        1 => "Software",
        2 => "Electronic",
        3 => "Mechanic",
        4 => "Production",
        _ => "Unknown"
    };
}
