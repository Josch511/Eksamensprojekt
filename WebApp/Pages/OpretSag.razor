@page "/opret-sag"

<PageTitle>Create a case</PageTitle>
<div class="case-parent">
    <div class="case-content">
        <h2>What is the case about?</h2>

        <div class="case-type">
            <h4>Case type</h4>
            <div class="case-type_select">
                <div class="case-type_select-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/bug.svg"/>
                    </div>
                    <p class="case-type_select-item-text">Problem/Error</p>
                </div>
                <div class="case-type_select-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/settings-2.svg"/>
                    </div>
                    <p class="case-type_select-item-text">Feature request</p>
                </div>
            </div>
        </div>
        <div class="case-departments">
            <h4>Department</h4>
            <div class="department-list">
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/code-xml.svg"/>
                    </div>
                    <p class="department-item-title">Software</p>
                </div>
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/plug.svg"/>
                    </div>
                    <p class="department-item-title">Electronic</p>
                </div>
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/wrench.svg"/>
                    </div>
                    <p class="department-item-title">Mechanic</p>
                </div>
                <div class="department-item">
                    <div class="case_icon-wrapper">
                        <img class="case_icon" src="assets/factory.svg"/>
                    </div>
                    <p class="department-item-title">Production</p>
                </div>
            </div>
        </div>
    </div>
</div>




@code {

    private int selectedOrderItemId;

    protected override async Task OnInitializedAsync()
    {
        selectedOrderItemId = await localStorage.GetItemAsync<int>("selectedOrderItemId");
    }
}